# =========================================================
# Qdrant Vector Database Backend Configuration
# =========================================================

# VECTOR_DB_MODE selects the Qdrant backend.
# Allowed values:
#   server   - Connect to an external Qdrant server (Docker / Qdrant Cloud). DEFAULT.
#   embedded - Use local on-disk Qdrant. No Docker required.
VECTOR_DB_MODE=server

# ---- SERVER MODE settings (used when VECTOR_DB_MODE=server) ----
QDRANT_HOST=localhost
QDRANT_PORT=6333
# QDRANT_API_KEY=your_key_here          # Required in non-dev environments
# QDRANT_URL=https://your-cloud.qdrant.io  # Optional: use instead of HOST/PORT for Qdrant Cloud

# ---- EMBEDDED MODE settings (used when VECTOR_DB_MODE=embedded) ----
# QDRANT_PATH=./qdrant_data             # Path where vectors are persisted on disk
                                        # Defaults to ./qdrant_data if not set

# =========================================================
# Example: Switch to embedded mode (no Docker needed)
# =========================================================
# VECTOR_DB_MODE=embedded
# QDRANT_PATH=./qdrant_data
